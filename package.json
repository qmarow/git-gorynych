{
  "name": "git-gorynych",
  "productName": "git-Горыныч",
  "version": "2.0.0-alpha.0",
  "description": "git-Горыныч — desktop Git client (Rust + Tauri + React + Tailwind)",
  "author": "ironxenot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "ui:watch": "vite build --watch",
    "typecheck": "node scripts/i18n-types.mjs --check && tsc -p tsconfig.json",
    "i18n:types": "node scripts/i18n-types.mjs",
    "app:build": "vite build && cargo build --release -p gorynych-tauri --features custom-protocol",
    "app:installer": "tauri build"
  },
  "devDependencies": {
    "@fluent/bundle": "^0.19.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^7.0.4",
    "zustand": "^5.0.8"
  }
}
