[{"id":1754874,"type":"comment","html_url":"https://gitea.com/gitea/tea/issues/1129#issuecomment-1754874","pull_request_url":"","issue_url":"https://gitea.com/gitea/tea/issues/1129","user":{"id":173651,"login":"bircni","type":"User","login_name":"","source_id":0,"full_name":"bircni","email":"173651+bircni@noreply.gitea.com","avatar_url":"https://gitea.com/avatars/9b753b6bef510146768e173e70a1a3904a76262c3a0b95e6579d06976650f3d4","html_url":"https://gitea.com/bircni","language":"","is_admin":false,"last_login":"0001-01-01T00:00:00Z","created":"2026-01-25T11:14:23Z","restricted":false,"active":false,"prohibit_login":false,"location":"","website":"","description":"","visibility":"public","followers_count":0,"following_count":2,"starred_repos_count":2,"username":"bircni"},"body":"目前 Gitea API 没有\"无指派人\"的筛选条件，可以在客户端过滤（需要 tea 1.0，即当前 main 分支）：\n\n```\ntea issue list --state all --limit 100 --json number,title,assignees --jq '.[] | select(.assignees | length == 0)'\n```\n\n超过 100 条时请配合 `--page 2`、`--page 3` 等翻页。\n\n(Gitea's API has no \"unassigned\" filter, so filter client-side as above with tea 1.0; use `--page` for more than 100 issues.)","created_at":"2026-10-11T18:41:02Z","updated_at":"2026-10-11T18:41:02Z","old_project_id":0,"project_id":0,"old_milestone":null,"milestone":null,"tracked_time":null,"old_title":"","new_title":"","old_ref":"","new_ref":"","ref_issue":null,"ref_comment":null,"ref_action":"none","ref_commit_sha":"","review_id":0,"label":null,"assignee":null,"assignee_team":null,"removed_assignee":false,"resolve_doer":null,"dependent_issue":null},{"id":1754875,"type":"close","html_url":"https://gitea.com/gitea/tea/issues/1129#issuecomment-1754875","pull_request_url":"","issue_url":"https://gitea.com/gitea/tea/issues/1129","user":{"id":173651,"login":"bircni","type":"User","login_name":"","source_id":0,"full_name":"bircni","email":"173651+bircni@noreply.gitea.com","avatar_url":"https://gitea.com/avatars/9b753b6bef510146768e173e70a1a3904a76262c3a0b95e6579d0697