{
  // Фаза 4: интерфейс переводится на TypeScript постепенно. Проверяются только файлы .ts; JSX 1.x — позже, по модулю.
  // Проверка: npm run typecheck
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // bindings/commands.ts — типы команд, которые генерирует `tauri-specta`: модули интерфейса будут импортировать их
  "include": ["src/**/*.ts", "crates/gorynych-tauri/bindings/commands.ts"]
}
