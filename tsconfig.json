{
  // Фаза 4: интерфейс на TypeScript (на .jsx остался только неиспользуемый components/GitLabPanel.jsx). Проверяются .ts и .tsx.
  // Проверка: npm run typecheck
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // bindings/commands.ts — типы команд, которые генерирует `tauri-specta`: модули интерфейса будут импортировать их
  "include": ["src/**/*.ts", "src/**/*.tsx", "crates/gorynych-tauri/bindings/commands.ts"]
}
